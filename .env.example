# AstroTeller — Environment Configuration
# Copy this file to .env and fill in your values.

# --- Required ---
ASTROLOGY_API_KEY=your_navamsha_api_key_here
SECRET_KEY=your_jwt_secret_key_here

# --- Database ---
DATABASE_URL=sqlite:///./astro_teller.db

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- External API (Navamsha) ---
# Timeout in seconds for calls to the Navamsha Astrology API
ASTROLOGY_API_TIMEOUT=15

# --- LLM Integration (Gemini AI) ---
# Your Google AI Gemini API Key (keep this private!)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- CORS (for frontend integration) ---
# Comma-separated list of allowed origins, e.g. http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000