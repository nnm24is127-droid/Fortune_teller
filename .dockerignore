# ── Version control ────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual Environments ───────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Secrets & Local Config ─────────────────────────────────────────────────
.env
*.pem
*.key
*.cert

# ── Local SQLite databases (volume mounted at runtime) ─────────────────────
*.db
*.sqlite3
data/*.db

# ── Test & Coverage Artifacts ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Application Logs (volume mounted at runtime) ───────────────────────────
logs/
*.log

# ── IDEs & Operating System ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Documentation & Repo files not needed in runtime container ─────────────
README.md
CONTRIBUTING.md
LICENSE
